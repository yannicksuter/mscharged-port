Subject: [PATCH] Project original audio settings views onto native source objects
Upstream-base: f1e9646a7da6950143e77b1daed33a92c931a638
Scope: live native ABI only. Preserve original slider/calculation objects,
       source member accesses, volume decisions, initialization and callbacks.

diff --git a/include/Game/Audio/AudioSystem.h b/include/Game/Audio/AudioSystem.h
--- a/include/Game/Audio/AudioSystem.h
+++ b/include/Game/Audio/AudioSystem.h
@@ -8,6 +8,9 @@
 #include "NL/nlDLListContainer.h"
 #include "NL/CircularQueue.h"
 #include "types.h"
+#if defined(MSCHARGED_NATIVE)
+#include "platform/native_audio_settings_layout.h"
+#endif
 
 class XSoundHandle;
 class XSoundCueHandle;
@@ -17,19 +20,31 @@
 
 struct AudioValues
 {
+#if defined(MSCHARGED_NATIVE)
+    /* 0x00 */ u8 m_unk00[mscharged::platform::audio_settings_abi::MusicTarget];
+#else
     /* 0x00 */ u8 m_unk00[0x5C];
+#endif
     /* 0x5C */ float m_unk5C;
     /* 0x60 */ float m_unk60;
     /* 0x64 */ u8 m_unk64[0x4];
     /* 0x68 */ float m_unk68;
     /* 0x6C */ float m_unk6C;
+#if defined(MSCHARGED_NATIVE)
+    /* 0x70 */ u8 m_unk70[mscharged::platform::audio_settings_abi::BetweenVolumeFields];
+#else
     /* 0x70 */ u8 m_unk70[0x14];
+#endif
     /* 0x84 */ float m_unk84;
     /* 0x88 */ float m_unk88;
     /* 0x8C */ u8 m_unk8C[0x4];
     /* 0x90 */ float m_unk90;
     /* 0x94 */ float m_unk94;
+#if defined(MSCHARGED_NATIVE)
+    /* 0x98 */ u8 m_unk98[mscharged::platform::audio_settings_abi::BetweenVolumeFields];
+#else
     /* 0x98 */ u8 m_unk98[0x14];
+#endif
     /* 0xAC */ float m_unkAC;
     /* 0xB0 */ float m_unkB0;
     /* 0xB4 */ u8 m_unkB4[0x4];
@@ -39,15 +54,56 @@
 
 struct AudioValuesOwner
 {
+#if defined(MSCHARGED_NATIVE)
+    /* 0x00 */ u8 m_unk00[mscharged::platform::audio_settings_abi::TableSliders];
+#else
     /* 0x00 */ u8 m_unk00[0x8];
+#endif
     /* 0x08 */ AudioValues* m_unk08;
 };
 
 struct AudioRuntime
 {
+#if defined(MSCHARGED_NATIVE)
+    /* 0x00 */ u8 m_unk00[mscharged::platform::audio_settings_abi::BundleCalculations];
+#else
     /* 0x00 */ u8 m_unk00[0x10];
+#endif
     /* 0x10 */ AudioValuesOwner* m_unk10;
 };
+
+#if defined(MSCHARGED_NATIVE)
+static_assert(offsetof(AudioRuntime, m_unk10)
+    == mscharged::platform::audio_settings_abi::BundleCalculations);
+static_assert(offsetof(AudioValuesOwner, m_unk08)
+    == mscharged::platform::audio_settings_abi::TableSliders);
+static_assert(sizeof(AudioValuesOwner) == sizeof(AudioCalculationTable));
+static_assert(offsetof(AudioValues, m_unk5C)
+    == mscharged::platform::audio_settings_abi::MusicTarget);
+static_assert(offsetof(AudioValues, m_unk60)
+    == 2 * sizeof(AudioCalculationSlider) + mscharged::platform::audio_settings_abi::Elapsed);
+static_assert(offsetof(AudioValues, m_unk68)
+    == 2 * sizeof(AudioCalculationSlider) + mscharged::platform::audio_settings_abi::Minimum);
+static_assert(offsetof(AudioValues, m_unk6C)
+    == 2 * sizeof(AudioCalculationSlider) + mscharged::platform::audio_settings_abi::Maximum);
+static_assert(offsetof(AudioValues, m_unk84)
+    == 3 * sizeof(AudioCalculationSlider) + mscharged::platform::audio_settings_abi::Target);
+static_assert(offsetof(AudioValues, m_unk88)
+    == 3 * sizeof(AudioCalculationSlider) + mscharged::platform::audio_settings_abi::Elapsed);
+static_assert(offsetof(AudioValues, m_unk90)
+    == 3 * sizeof(AudioCalculationSlider) + mscharged::platform::audio_settings_abi::Minimum);
+static_assert(offsetof(AudioValues, m_unk94)
+    == 3 * sizeof(AudioCalculationSlider) + mscharged::platform::audio_settings_abi::Maximum);
+static_assert(offsetof(AudioValues, m_unkAC)
+    == 4 * sizeof(AudioCalculationSlider) + mscharged::platform::audio_settings_abi::Target);
+static_assert(offsetof(AudioValues, m_unkB0)
+    == 4 * sizeof(AudioCalculationSlider) + mscharged::platform::audio_settings_abi::Elapsed);
+static_assert(offsetof(AudioValues, m_unkB8)
+    == 4 * sizeof(AudioCalculationSlider) + mscharged::platform::audio_settings_abi::Minimum);
+static_assert(offsetof(AudioValues, m_unkBC)
+    == 4 * sizeof(AudioCalculationSlider) + mscharged::platform::audio_settings_abi::Maximum);
+static_assert(sizeof(AudioValues) <= 5 * sizeof(AudioCalculationSlider));
+#endif
 
 class AudioSystem
 {
