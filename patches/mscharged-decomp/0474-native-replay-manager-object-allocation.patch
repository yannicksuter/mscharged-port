Subject: [PATCH] Adapt original Replay object storage to its native ABI
Upstream-base: 5f9047649dd6cfcf1a3268cf79be2e3d58d9a6c3

--- a/src/Game/ReplayManager.cpp
+++ b/src/Game/ReplayManager.cpp
@@ -204,7 +204,11 @@
 void ReplayManager::Initialize()
 {
     mMemory = (u8*)nlMalloc(0x100000, 0x20, false);
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    mReplay = new (nlMalloc(sizeof(Replay), 8, false)) Replay((char*)mMemory, 0x100000, 0x8000);
+#else
     mReplay = new (nlMalloc(0x48, 8, false)) Replay((char*)mMemory, 0x100000, 0x8000);
+#endif
     mTime = 0.0f;
 }
 
@@ -343,7 +347,11 @@
 void ReplayManager::Flush()
 {
     delete mReplay;
+#if defined(MSCHARGED_NATIVE) && defined(MSCHARGED_GAME_MODULE)
+    mReplay = new (nlMalloc(sizeof(Replay), 8, false)) Replay((char*)mMemory, 0x100000, 0x8000);
+#else
     mReplay = new (nlMalloc(0x48, 8, false)) Replay((char*)mMemory, 0x100000, 0x8000);
+#endif
 
     ResetSnapshots();
 }
