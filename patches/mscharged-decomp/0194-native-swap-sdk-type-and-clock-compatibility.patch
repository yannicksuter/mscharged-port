From: mscharged native port
Subject: [PATCH] Reuse native SDK colour/compare types and forward the hardware clock
Upstream-base: 8b0505a47990d684d1588749f40babb9c0483490

The canonical native GX header already supplies the original four-byte colour
and compare value. Keep the console declarations, and use those SDK identities
on native builds. Read the actual Wii-configured native bus clock beneath the
original swap timing arithmetic rather than dereferencing a console address.
No source function body, callback selection, frame counter or swap decision
changes. Native runtime swap/screenshot/VI/GX execution remains unqualified.

diff --git a/src/NL/glx/glxSwap.cpp b/src/NL/glx/glxSwap.cpp
--- a/src/NL/glx/glxSwap.cpp
+++ b/src/NL/glx/glxSwap.cpp
@@ -47,6 +47,7 @@
     int fclose(FILE* file);
 }
 
+#ifndef MSCHARGED_NATIVE
 struct GXColor
 {
     u8 r;
@@ -54,6 +55,7 @@
     u8 b;
     u8 a;
 };
+#endif
 
 extern "C" void GXSetCopyClear(GXColor clear_clr, u32 clear_z);
 
@@ -61,12 +63,19 @@
 // the nlConfig translation unit and called from here as well.
 void* ConfigParserAllocate(unsigned long size, unsigned int alignment, bool fromEnd);
 
+#ifndef MSCHARGED_NATIVE
 enum
 {
     GX_LEQUAL = 3
 };
-
+#endif
+
+#ifdef MSCHARGED_NATIVE
+extern "C" u32 ChargedGetBusClock();
+#define OS_BUS_CLOCK                 ChargedGetBusClock()
+#else
 #define OS_BUS_CLOCK                 (*(u32*)0x800000F8)
+#endif
 #define OS_TIMER_CLOCK               (OS_BUS_CLOCK / 4)
 #define OSTicksToMicroseconds(ticks) (((ticks) * 8) / (OS_TIMER_CLOCK / 125000))
 
@@ -96,8 +96,16 @@
 static void glx_ScreenCapture(bool isMovie);
 static void PutPixel(u8* dst, u32 argbColor);
 static void loading_indicator();
+#if defined(MSCHARGED_NATIVE)
+static void vi_pre_cb(u32);
+#else
 static void vi_pre_cb(unsigned long);
+#endif
+#if defined(MSCHARGED_NATIVE)
+static void vi_post_cb(u32);
+#else
 static void vi_post_cb(unsigned long);
+#endif
 static void draw_done_cb();
 static void AdvanceFrame();
 static void ReportGPStatus();
@@ -274,12 +282,20 @@
     }
 }
 
+#if defined(MSCHARGED_NATIVE)
+static void vi_pre_cb(u32)
+#else
 static void vi_pre_cb(unsigned long)
+#endif
 {
     bInRetrace = 1;
 }
 
+#if defined(MSCHARGED_NATIVE)
+static void vi_post_cb(u32)
+#else
 static void vi_post_cb(unsigned long)
+#endif
 {
     HandleSoftReset();
     if (glx_bLoadingIndicator != 0)
