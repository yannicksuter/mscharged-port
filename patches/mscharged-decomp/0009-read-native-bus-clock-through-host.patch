Subject: Read the host OS bus clock instead of defining console low-memory globals

Upstream-base: 5f9047649dd6cfcf1a3268cf79be2e3d58d9a6c3

Each original time unit maps __OSBusClock to the same console address.
Native builds must not create duplicate uninitialized globals. Read the
initialized Aurora clock through a typed host bridge, preserving tick conversion
math. Full Wii clock/simulation parity remains separate validation work.

diff --git a/src/NL/nlTicker.cpp b/src/NL/nlTicker.cpp
--- a/src/NL/nlTicker.cpp
+++ b/src/NL/nlTicker.cpp
@@ -4,7 +4,12 @@
 #include <revolution/os/OSTime_fwd.h>
 
 
+#ifdef MSCHARGED_NATIVE
+extern "C" u32 ChargedGetBusClock();
+#define __OSBusClock ChargedGetBusClock()
+#else
 u32 __OSBusClock AT_ADDRESS(0x800000F8);
+#endif
 
 void nlInitTicker()
 {
diff --git a/src/NL/nlTime.cpp b/src/NL/nlTime.cpp
--- a/src/NL/nlTime.cpp
+++ b/src/NL/nlTime.cpp
@@ -4,7 +4,12 @@
 
 #include "decomp.h"
 
+#ifdef MSCHARGED_NATIVE
+extern "C" u32 ChargedGetBusClock();
+#define __OSBusClock ChargedGetBusClock()
+#else
 u32 __OSBusClock AT_ADDRESS(0x800000F8);
+#endif
 
 void nlInitTime()
 {
