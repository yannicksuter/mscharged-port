+++ b/src/ode/array.h
@@ -40,6 +40,9 @@
 #define _ODE_ARRAY_H_
 
 #include <ode/config.h>
+#if defined(MSCHARGED_NATIVE)
+#include <string.h>
+#endif
 
 
 // this base class has no constructors or destructor, for your convenience.
